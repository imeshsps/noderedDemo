        "id": "bedroom_func",
        "type": "function",
        "z": "homeautomation",
        "name": "Bedroom Data",
        "func": "const time = new Date().getSeconds();\nconst temp = (19 + Math.sin(time / 12) * 2 + (Math.random() - 0.5)).toFixed(1);\nconst humidity = (50 + Math.sin(time / 18) * 8 + (Math.random() - 0.5) * 3).toFixed(1);\nconst light = Math.floor(Math.random() * 30); // Usually dark\n\nmsg.payload = {\n    temperature: parseFloat(temp),\n    humidity: parseFloat(humidity),\n    lightLevel: light,\n    room: \"Bedroom\",\n    timestamp: new Date().toISOString()\n};\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
