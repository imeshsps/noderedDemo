    {
        "id": "energy_inject",
        "type": "inject",
        "z": "homeautomation",
        "name": "Energy Monitor",
        "props": [{"p": "payload"}],
        "repeat": "1",
        "crontab": "",
        "once": true,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "x": 140,
