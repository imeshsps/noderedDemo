    {
        "id": "weather_func",
        "type": "function",
        "z": "homeautomation",
        "name": "Weather Data",
        "func": "const conditions = [\n    {icon: '☀️', desc: 'Sunny', temp: 28},\n    {icon: '⛅', desc: 'Partly Cloudy', temp: 24},\n    {icon: '☁️', desc: 'Cloudy', temp: 20},\n    {icon: '🌧️', desc: 'Rainy', temp: 18},\n    {icon: '⛈️', desc: 'Stormy', temp: 16}\n];\n\nconst weather = conditions[Math.floor(Math.random() * conditions.length)];\nconst temp = weather.temp + (Math.random() - 0.5) * 4;\nconst windSpeed = Math.floor(5 + Math.random() * 25);\nconst pressure = Math.floor(1000 + Math.random() * 40);\n\nmsg.payload = {\n    icon: weather.icon,\n    condition: weather.desc,\n    temperature: temp.toFixed(1),\n    windSpeed: windSpeed,\n    pressure: pressure,\n    timestamp: new Date().toISOString()\n};\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 860,
        "wires": [["weather_display", "wind_gauge"]]
