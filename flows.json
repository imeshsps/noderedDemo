    {
        "id": "energy_func",
        "type": "function",
        "z": "homeautomation",
        "name": "Generate Energy Data",
        "func": "// Generate random power consumption\nconst power = (500 + Math.random() * 2500).toFixed(0);\nconst voltage = (220 + Math.random() * 20).toFixed(1);\nconst current = (power / voltage).toFixed(2);\n\nmsg.payload = {\n    power: parseFloat(power),\n    voltage: parseFloat(voltage),\n    current: parseFloat(current),\n    unit: 'W',\n    timestamp: new Date().toISOString()\n};\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
        "y": 620,
        "wires": [["energy_debug", "energy_chart", "energy_gauge"]]
