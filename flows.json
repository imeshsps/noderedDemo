        "id": "security_inject",
        "type": "inject",
        "z": "homeautomation",
        "name": "Security System",
        "props": [{"p": "payload"}],
        "repeat": "4",
        "crontab": "",
        "once": true,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "",
