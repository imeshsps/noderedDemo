    {
        "id": "security_func",
        "type": "function",
        "z": "homeautomation",
        "name": "Security Logic",
        "func": "const sensors = [\n    {type: '🚪 Door', locations: ['Front Door', 'Back Door', 'Garage']},\n    {type: '🚶 Motion', locations: ['Hallway', 'Living Room', 'Garden', 'Driveway']},\n    {type: '🪟 Window', locations: ['Kitchen Window', 'Bedroom Window', 'Study Window']}\n];\n\nconst sensor = sensors[Math.floor(Math.random() * sensors.length)];\nconst location = sensor.locations[Math.floor(Math.random() * sensor.locations.length)];\n\nlet status, color;\nif (sensor.type.includes('Motion')) {\n    status = Math.random() > 0.6 ? 'DETECTED' : 'CLEAR';\n    color = status === 'DETECTED' ? '#ffb800' : '#06ffa5';\n} else {\n    status = Math.random() > 0.8 ? 'OPEN' : 'CLOSED';\n    color = status === 'OPEN' ? '#ff006e' : '#06ffa5';\n}\n\nmsg.payload = {\n    sensor: sensor.type,\n    location: location,\n    status: status,\n    color: color,\n    timestamp: new Date().toISOString()\n};\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 350,
        "y": 580,
        "wires": [["security_display", "security_log"]]
    },
