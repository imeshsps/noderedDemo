    {
        "id": "livingroom_func",
        "type": "function",
        "z": "homeautomation",
        "name": "Living Room Data",
        "func": "// Create more dynamic temperature simulation\nconst baseTemp = 22;\nconst time = new Date().getSeconds();\nconst tempVariation = Math.sin(time / 10) * 3;\nconst temp = (baseTemp + tempVariation + (Math.random() - 0.5)).toFixed(1);\n\nconst baseHumidity = 55;\nconst humidity = (baseHumidity + Math.sin(time / 15) * 10 + (Math.random() - 0.5) * 5).toFixed(1);\n\nconst airQuality = Math.floor(50 + Math.random() * 50);\nconst co2 = Math.floor(400 + Math.random() * 200);\n\nmsg.payload = {\n    temperature: parseFloat(temp),\n    humidity: parseFloat(humidity),\n    airQuality: airQuality,\n    co2: co2,\n    room: \"Living Room\",\n    timestamp: new Date().toISOString()\n};\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 120,
        "wires": [["living_temp_gauge", "living_humidity_gauge", "living_air_gauge", "temp_chart", "living_status"]]
    },
