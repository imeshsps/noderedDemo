    {
        "id": "thermostat_func",
        "type": "function",
        "z": "homeautomation",
        "name": "Generate Thermostat Data",
        "func": "// Generate thermostat data\nconst currentTemp = (18 + Math.random() * 8).toFixed(1);\nconst targetTemp = (20 + Math.random() * 4).toFixed(1);\nconst modes = ['heat', 'cool', 'auto', 'off'];\nconst mode = modes[Math.floor(Math.random() * modes.length)];\nconst fanSpeed = Math.floor(1 + Math.random() * 3);\n\nmsg.payload = {\n    currentTemp: parseFloat(currentTemp),\n    targetTemp: parseFloat(targetTemp),\n    mode: mode,\n    fanSpeed: fanSpeed,\n    status: mode === 'off' ? 'OFF' : 'RUNNING',\n    timestamp: new Date().toISOString()\n};\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 740,
        "wires": [["thermostat_debug", "thermostat_text"]]
    },
