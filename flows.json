    {
        "id": "lights_func",
        "type": "function",
        "z": "homeautomation",
        "name": "Smart Lights Logic",
        "func": "const rooms = [\n    {name: '🛋️ Living Room', color: '#FFD700'},\n    {name: '🛏️ Bedroom', color: '#FF69B4'},\n    {name: '🍳 Kitchen', color: '#FFFFFF'},\n    {name: '🚿 Bathroom', color: '#87CEEB'},\n    {name: '📖 Study', color: '#98FB98'}\n];\n\nconst room = rooms[Math.floor(Math.random() * rooms.length)];\nconst status = Math.random() > 0.4 ? 'ON' : 'OFF';\nconst brightness = status === 'ON' ? Math.floor(30 + Math.random() * 70) : 0;\nconst power = status === 'ON' ? (brightness * 0.12).toFixed(1) : 0;\n\nmsg.payload = {\n    room: room.name,\n    status: status,\n    brightness: brightness,\n    power: parseFloat(power),\n    color: room.color,\n    timestamp: new Date().toISOString()\n};\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
        "y": 440,
        "wires": [["lights_status", "lights_chart", "total_lights"]]
    },
    {
        "id": "lights_status",
        "type": "ui_text",
        "z": "homeautomation",
        "group": "lights_group",
        "order": 1,
        "width": "6",
        "height": "1",
        "name": "Light Status",
        "label": "",
        "format": "<font color='{{msg.payload.status == \"ON\" ? \"#06ffa5\" : \"#666\"}}'>{{msg.payload.room}}: <b>{{msg.payload.status}}</b> {{msg.payload.status == \"ON\" ? \"(\" + msg.payload.brightness + \"%)\" : \"\"}}</font>",
        "layout": "row-left",
        "x": 590,
        "y": 420,
        "wires": []
    },
