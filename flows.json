    {
        "id": "lights_func",
        "type": "function",
        "z": "homeautomation",
        "name": "Generate Light Data",
        "func": "// Randomly toggle lights\nconst rooms = ['Living Room', 'Bedroom', 'Kitchen', 'Bathroom'];\nconst room = rooms[Math.floor(Math.random() * rooms.length)];\nconst status = Math.random() > 0.5 ? 'ON' : 'OFF';\nconst brightness = status === 'ON' ? Math.floor(20 + Math.random() * 80) : 0;\n\nmsg.payload = {\n    room: room,\n    status: status,\n    brightness: brightness,\n    timestamp: new Date().toISOString()\n};\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
        "y": 320,
        "wires": [["lights_debug", "lights_text"]]
    },
    {
        "id": "lights_debug",
        "type": "debug",
        "z": "homeautomation",
        "name": "Lights Debug",
        "active": true,
