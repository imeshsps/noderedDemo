    {
        "id": "total_lights",
        "type": "function",
        "z": "homeautomation",
        "name": "Count Active Lights",
        "func": "let count = context.get('lightCount') || 0;\nif (msg.payload.status === 'ON') {\n    count++;\n} else if (count > 0) {\n    count--;\n}\ncontext.set('lightCount', count);\nmsg.payload = count;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 610,
        "y": 500,
