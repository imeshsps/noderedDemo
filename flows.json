        "wires": [["energy_func"]]
    },
    {
        "id": "energy_func",
        "type": "function",
        "z": "homeautomation",
        "name": "Energy Calculation",
        "func": "const time = new Date().getSeconds();\nconst baseLoad = 800;\nconst variation = Math.sin(time / 5) * 500;\nconst power = Math.max(300, baseLoad + variation + (Math.random() * 400));\n\nconst voltage = (230 + (Math.random() - 0.5) * 10).toFixed(1);\nconst current = (power / parseFloat(voltage)).toFixed(2);\nconst cost = (power * 0.00015).toFixed(2); // Cost per hour\n\n// Calculate daily consumption estimate\nlet totalEnergy = context.get('totalEnergy') || 0;\ntotalEnergy += power / 3600; // Wh\ncontext.set('totalEnergy', totalEnergy);\n\nmsg.payload = {\n    power: Math.floor(power),\n    voltage: parseFloat(voltage),\n    current: parseFloat(current),\n    cost: parseFloat(cost),\n    totalKwh: (totalEnergy / 1000).toFixed(2),\n    timestamp: new Date().toISOString()\n};\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
        "y": 700,
        "wires": [["energy_gauge", "energy_chart", "energy_stats", "voltage_text"]]
    },
