{
  "name": "nodered-home-automation-demo",
  "version": "1.0.0",
  "description": "Node-RED Home Automation Demo with dynamic dummy data",
  "main": "index.js",
  "scripts": {
    "prestart": "pkill -f 'node-red' 2>/dev/null || true",
    "start": "node-red --settings ./settings.js --userDir .",
    "stop": "pkill -f 'node-red' || echo 'No Node-RED process found'"
  },
  "keywords": [
    "node-red",
    "home-automation",
    "iot",
    "demo"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "node-red": "^3.1.0",
    "node-red-dashboard": "^3.6.0"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
